# Copy to .env and fill in values before: docker compose up -d --build
# Backend читает переменные из этого файла (env_file в compose).
# DATABASE_URL в контейнере api подставляется сам (хост mysql).

# MySQL
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=project2brothers

# Public HTTP port on the host
HTTP_PORT=80

# Backend
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=access_token
# Browser origin(s), comma-separated. Examples:
#   http://YOUR_VPS_IP
#   https://your-domain.com
CORS_ORIGIN=http://localhost

# Seed demo users/menu on first start (true/false)
SEED_ON_START=true

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# DaData address suggestions (optional; checkout works without it, but no autocomplete)
DADATA_API_KEY=

# Backups (optional)
# BACKUP_DIR=/var/backups/project2brothers   # for host script deploy/backup-mysql.sh
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_SEC=86400                 # docker service `backup` (default 24h)
# BACKUP_FIRST_DELAY_SEC=120
